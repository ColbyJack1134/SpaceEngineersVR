<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SpaceEngineersVR.FlatscreenCompanion</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <GameBinPath Condition="'$(GameBinPath)' == '' and '$(OS)' == 'Windows_NT'">C:\Program Files (x86)\Steam\steamapps\common\SpaceEngineers\Bin64</GameBinPath>
    <GameBinPath Condition="'$(GameBinPath)' == ''">/mnt/c/Program Files (x86)/Steam/steamapps/common/SpaceEngineers/Bin64</GameBinPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="HavokWrapper"><HintPath>$(GameBinPath)/HavokWrapper.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sandbox.Common"><HintPath>$(GameBinPath)/Sandbox.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sandbox.Game"><HintPath>$(GameBinPath)/Sandbox.Game.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sandbox.Graphics"><HintPath>$(GameBinPath)/Sandbox.Graphics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SpaceEngineers.ObjectBuilders"><HintPath>$(GameBinPath)/SpaceEngineers.ObjectBuilders.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SpaceEngineers.Game"><HintPath>$(GameBinPath)/SpaceEngineers.Game.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage"><HintPath>$(GameBinPath)/VRage.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Game"><HintPath>$(GameBinPath)/VRage.Game.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Input"><HintPath>$(GameBinPath)/VRage.Input.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Library"><HintPath>$(GameBinPath)/VRage.Library.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Math"><HintPath>$(GameBinPath)/VRage.Math.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Render"><HintPath>$(GameBinPath)/VRage.Render.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Network"><HintPath>$(GameBinPath)/VRage.Network.dll</HintPath><Private>false</Private></Reference>
    <Compile Include="../SpaceEngineersVR/Multiplayer/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../SpaceEngineersVR/Player/ArmSkeleton.cs" Link="Shared/ArmSkeleton.cs" />
    <Compile Include="../SpaceEngineersVR/Player/ArmMath.cs" Link="Shared/ArmMath.cs" />
    <Compile Include="../SpaceEngineersVR/Player/CockpitHandPose.cs" Link="Shared/CockpitHandPose.cs" />
    <Compile Include="../SpaceEngineersVR/Player/SegmentBox.cs" Link="Shared/SegmentBox.cs" />
    <Compile Include="../SpaceEngineersVR/Player/WeaponPose.cs" Link="Shared/WeaponPose.cs" />
  </ItemGroup>
</Project>
